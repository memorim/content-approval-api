DATABASE_URL=sqlite:///./approval.db
APP_NAME=approval-service
LOG_LEVEL=INFO
# Optional shared credential hashes/users in DATABASE_URL after alembic upgrade head.
# APP_AUTH_BACKEND=database
# Legacy file backend: APP_AUTH_DATABASE=/secure/auth.db (choose one backend).
OUTBOX_DIRECTORY=data/delivered-events
# Optional fixed operator-owned HTTPS destination; empty uses the local receiver.
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_TOKEN=

# Free generic push alternative to OUTBOX_WEBHOOK_URL; random topic >=32 characters.
# NTFY_TOPIC=
